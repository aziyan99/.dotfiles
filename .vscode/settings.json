{
    "extensions.ignoreRecommendations": true,
    "workbench.startupEditor": "none",
    "editor.codeActionsOnSave": {
        "source.addMissingImports": "always",
        "source.organizeImports": "always"
    },
    "editor.cursorSurroundingLines": 5,
    "editor.fontLigatures": true,
    "editor.formatOnSave": false,
    "editor.inlineSuggest.enabled": true,
    "editor.lineNumbers": "on",
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.suggestFontSize": 14,
    "editor.wordWrap": "on",
    "errorLens.fontStyleItalic": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.autoUpdate": "on",
    "workbench.settings.editor": "json",
    "zenMode.hideLineNumbers": false,
    "workbench.iconTheme": "vs-minimal",
    "php.suggest.basic": false,
    "explorer.compactFolders": false,
    "editor.stickyScroll.scrollWithEditor": false,
    "workbench.tree.enableStickyScroll": false,
    "workbench.editor.enablePreview": false,
    "editor.fontFamily": "'Iosevka Nerd Font Mono'",
    "workbench.layoutControl.enabled": false,
    "editor.mouseWheelZoom": true,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "hidden",
    "window.commandCenter": false,
    "workbench.browser.showInTitleBar": false,
    "window.menuBarVisibility": "compact",
    "Laravel.translation.diagnostics": false,
    "update.showReleaseNotes": false,
    "workbench.colorTheme": "Dark Modern",
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "vim.foldfix": true,
    "vim.highlightedyank.color": "rgba(230, 97, 89, 0.7)",
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.textColor": "white",
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "leader",
                "r"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "leader",
                "w"
            ],
            "commands": [
                ":w!"
            ]
        },
        {
            "before": [
                "leader",
                "q"
            ],
            "commands": [
                ":q!"
            ]
        },
        {
            "before": [
                "leader",
                "x"
            ],
            "commands": [
                ":x!"
            ]
        },
        {
            "after": [
                "g",
                "g",
                "V",
                "G"
            ],
            "before": [
                "<c-a>"
            ]
        },
        {
            "before": [
                "<leader>",
                "k"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev"
            ]
        },
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "after": [
                "^"
            ],
            "before": [
                "H"
            ]
        },
        {
            "after": [
                "$"
            ],
            "before": [
                "L"
            ]
        }
    ],
    "vim.useSystemClipboard": true,
    "intelephense.diagnostics.undefinedMethods": false,
    "intelephense.codeLens.overrides.enable": true,
    "intelephense.codeLens.usages.enable": true,
    "intelephense.codeLens.references.enable": true,
    "intelephense.diagnostics.undefinedFunctions": false,
    "files.associations": {
        "*.eex": "html-eex",
        "*.blade.php": "blade"
    },
    "emmet.includeLanguages": {
        "blade": "html"
    },
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.codeLens": false,
    "editor.inlayHints.enabled": "off",
    "editor.cursorBlinking": "solid",
    "[php]": {
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    },
    "tailwindCSS.lint.cssConflict": "ignore",
    "explorer.autoReveal": false
}
